# Claude
ANTHROPIC_API_KEY=sk-ant-...
# Effort for the live coaching loop (low keeps tips fast; medium/high are slower but deeper)
COACH_EFFORT=low
# Effort for the post-call summary
SUMMARY_EFFORT=high

# Twilio (the number the agent dials out from)
TWILIO_ACCOUNT_SID=AC...
TWILIO_AUTH_TOKEN=...
TWILIO_FROM_NUMBER=+15555550100

# Deepgram (streaming speech-to-text with speaker diarization)
DEEPGRAM_API_KEY=...

# Public HTTPS URL that Twilio can reach (e.g. an ngrok tunnel to this server)
PUBLIC_BASE_URL=https://your-tunnel.ngrok.app

# Shared secret the CLI uses to start calls on the server (any long random string)
NEGOTIATOR_ADMIN_TOKEN=change-me

# What the agent says when it joins. Many jurisdictions require every party's
# consent before a call is transcribed; leave this on unless you have consent another way.
ANNOUNCE_ON_JOIN=true
ANNOUNCEMENT_TEXT=Hello, an AI note taking assistant has joined this call to transcribe it.

# Where transcripts and summaries are written
SESSIONS_DIR=sessions
